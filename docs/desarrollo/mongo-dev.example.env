# Mongo de desarrollo. No es una credencial y Next no carga este archivo.
# Copiarlo a .env.development.local y reemplazar la clave.
# No renombrarlo a .env: ese nombre puede arrastrar el servidor operativo.
# No usar el host del VPS ni el puerto 27017.
# Instancia propia en 127.0.0.1:27019, base nelzuri_dev, usuario nelzuri_dev.
# authSource nelzuri_dev. Solo readWrite sobre nelzuri_dev.
# No definir MONGODB_DESTRUCTIVE_SCOPE: eso pertenece a las pruebas.

MONGODB_TARGET=isolated-dev
MONGODB_ISOLATED_HOST=127.0.0.1
MONGODB_ISOLATED_PORT=27019
MONGODB_DB=nelzuri_dev
MONGODB_URI=mongodb://nelzuri_dev:cambiar-esta-clave-local@127.0.0.1:27019/nelzuri_dev?authSource=nelzuri_dev
APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
AUTH_BACKEND=email
SESSION_SECRET=cambia-este-secreto-local
