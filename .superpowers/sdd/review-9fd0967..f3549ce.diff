+
+describe("buildConversionAnalytics ÔÇö p├®rdidas", () => {
+  it("cuenta etapa de salida, conserva p├®rdidas sin etapa y no registra motivos", () => {
+    const r = build({
+      opportunities: [
+        opp({ _id: "l1", status: "lost", closedAt: "2026-09-08T12:00:00.000Z" }),
+        opp({ _id: "l2", status: "lost", closedAt: "2026-09-08T12:00:00.000Z" }),
