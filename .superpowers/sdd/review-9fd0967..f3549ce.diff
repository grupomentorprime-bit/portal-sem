+          onCustomFrom={setCustomFrom}
+          onCustomTo={setCustomTo}
+          onApplyCustom={onApplyCustom}
+        />
+
+        {state.status === "error" ? (
+          <div data-conversion-analitica-error>
+            <AlertBanner
+              variant="warning"
+              title={GROWTH_ANALITICA_ERROR_TITLE}
