+
+describe("buildConversionAnalytics ÔÇö permanencia y ciclo", () => {
+  const nuevoOpened = (id: string, at: string) =>
+    opened(`op-${id}`, id, "nuevo", at);
+
+  it("mediana de intervalos terminados; en curso e historial incompleto no cuentan", () => {
+    const r = build({
