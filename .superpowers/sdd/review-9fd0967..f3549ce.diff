+});
+
+describe("buildConversionAnalytics ÔÇö stock y movimiento", () => {
+  it("stock ignora el per├¡odo; movimiento ilegible no mueve otra barra", () => {
+    const r = build({
+      opportunities: [
+        opp({
+          _id: "old",
+          status: "propuesta",
+          openedAt: "2026-01-01T00:00:00.000Z",
+        }),
