+
+export interface GrowthFunnelFieldOption {
+  key: string;
+  label: string;
+  active: boolean;
+}
+
+export interface GrowthFunnelField {
+  key: string;
+  label: string;
+  type: GrowthFunnelFieldType;
+  required: boolean;
+  position: number;
+  active: boolean;
+  options?: GrowthFunnelFieldOption[];
+  help?: string;
+}
+
+export interface GrowthFunnel {
+  _id: string;
+  tenantId: string;
+  key: string;
+  name: string;
+  status: "active" | "archived";
+  isDefault: boolean;
+  workflowDefinitionKey: string;
+  /** Campos del embudo. Vac├¡o si a├║n no se definieron. */
+  fields?: GrowthFunnelField[];
+  createdAt: string;
+  updatedAt: string;
+}
+
+export interface GrowthFunnelStage {
+  key: string;
+  label: string;
+  position: number;
+  active: boolean;
+  isInitial: boolean;
+  isResult: boolean;
+}
+
+export interface GrowthFunnelTransition {
+  id: string;
+  fromState: string;
+  toState: string;
+  label: string;
+}
+
+export interface GrowthFunnelDefinition {
+  _id: string;
+  tenantId: string;
+  key: string;
+  name: string;
+  initialState: string;
+  states: Array<{
+    key: string;
+    label: string;
+    isInitial?: boolean;
+    isFinal?: boolean;
+    metadata?: Record<string, unknown>;
+  }>;
+  transitions: GrowthFunnelTransition[];
+  version: number;
+}
+
+export type GrowthFunnelFailure =
+  | "invalid_key"
+  | "duplicate_key"
+  | "not_found"
+  | "reserved_stage"
+  | "duplicate_stage"
+  | "cannot_deactivate_initial"
+  | "cannot_deactivate_result"
+  | "cannot_deactivate_last_active"
+  | "cannot_rename_result"
+  | "open_opportunities"
+  | "default_required"
+  | "archived"
+  | "not_intermediate";
