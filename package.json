{
  "name": "portal-sem",
  "version": "2.5.0",
  "private": true,
  "engines": {
    "node": "20"
  },
  "scripts": {
    "dev": "tsx scripts/assert-dev-mongo.ts && next dev",
    "build": "npm run check:branding && npm run build:institutional-media && next build",
    "build:docker": "npm run build:institutional-media && next build",
    "start": "next start",
    "start:next": "next start",
    "lint": "eslint",
    "test:baseline": "node --require ./scripts/refuse-operational-mongo.cjs ./node_modules/tsx/dist/cli.mjs --test tests/baseline/**/*.test.ts tests/smoke/**/*.test.ts",
    "test:smoke": "node --require ./scripts/refuse-operational-mongo.cjs ./node_modules/tsx/dist/cli.mjs --test tests/smoke/**/*.test.ts",
    "test:isolated": "node --require ./scripts/refuse-operational-mongo.cjs --env-file=.env.mongo-aislado ./node_modules/tsx/dist/cli.mjs --test tests/baseline/local-mongo-boundary.test.ts tests/baseline/destructive-mongo-guard.test.ts tests/baseline/synthetic-spaces.test.ts tests/baseline/universal-foundation.test.ts tests/baseline/saas-foundation.test.ts tests/baseline/saas-adl-tenant.test.ts tests/baseline/platform-delete-space.test.ts tests/baseline/desktop-session-routes.test.ts tests/baseline/nelzuri-specialized.test.ts tests/baseline/nelzuri-shell-boundary.test.ts tests/baseline/nelzuri-capability-ownership.test.ts",
    "fixtures:dev": "tsx scripts/seed-synthetic-spaces.ts",
    "check:branding": "tsx scripts/check-branding.ts",
    "generate:editorial": "tsx scripts/generate-editorial-assets.ts",
    "build:institutional-media": "tsx scripts/build-institutional-media.ts",
    "normalize:team-portraits": "node scripts/normalize-team-portraits.mjs",
    "migrate:media-ids": "npx tsx scripts/migrate-media-ids.ts",
    "migrate": "npx tsx scripts/migrate.ts",
    "migrate:hero-v2": "npx tsx scripts/migrate.ts 001-hero-v2",
    "migrate:local-media-to-s3": "npx tsx scripts/migrate-local-cms-media-to-s3.ts",
    "backfill:growth": "node --require ./scripts/_stub-server-only.cjs ./node_modules/tsx/dist/cli.mjs --env-file=.env scripts/backfill-growth-core.ts",
    "sync:tenant-roles": "npx tsx scripts/sync-tenant-roles.ts",
    "setup:keycloak": "npx tsx scripts/setup-keycloak-client.ts",
    "align:keycloak-identity": "npx tsx scripts/align-keycloak-identity.ts",
    "check:keycloak": "npx tsx scripts/check-keycloak.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.22.0",
    "mongodb": "^7.4.0",
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.16.0",
    "sanitize-html": "^2.17.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
}
