# Plantilla de entorno — copiar a .env.local y completar valores reales.
# Nunca uses el prefijo NEXT_PUBLIC_ para secretos (Mongo, Keycloak, S3, Resend, SESSION_SECRET).
# La única variable pensada para el cliente es NEXT_PUBLIC_APP_URL (URL pública del portal).

# Base de datos
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=portal_sem

# Identidad y sesiones
# IDENTITY_ENFORCE ya no abre zonas privadas si falta o es false (OT-GROWTH-SEC-002).
IDENTITY_ENFORCE=true
SESSION_SECRET=genera-un-secreto-largo-y-aleatorio
# email | keycloak (solo Keycloak deshabilita login local)
AUTH_BACKEND=keycloak

# URL pública canónica de la app/plataforma (emails, OAuth, cookies Secure si es https://,
# canonical de /legal, sitemap, robots). Describe el origen — NO asigna identidad de Espacio.
# Debe coincidir con el protocolo real (http vs https) del dominio en producción.
# Hosts de tenants viven en la colección `domains` (Host → Domain → Site → Tenant).
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Base de subdominios de plataforma (opcional). Ej.: acme.portales.example.com
# Solo modelo de aplicación — no provisiona DNS/TLS automáticamente.
# PLATFORM_BASE_DOMAIN=portales.example.com
# Host de desarrollo de Tenant 002 (Academia ADL). No usar el host canónico de plataforma.
# ADL_DEV_HOST=adl.localhost:3000
# Email (usuario ya existente) al que se asigna membresía controlada en T002 para probar el switcher.
# ADL_BOOTSTRAP_MEMBER_EMAIL=soporte@mentorprime.cl
# Forzar Secure en la cookie de sesión (opcional; por defecto se infiere de APP_URL)
# SESSION_COOKIE_SECURE=false

# BackOffice — Shell Administrativo V2 (OT-UX-IMPLEMENTACION-001 Fase 1)
ADMIN_SHELL_V2=true

# Correo transaccional (Resend) — transporte de Growth OS, no identidad del Espacio.
# EMAIL_FROM es el buzón técnico de proceso. El nombre visible del remitente
# sale de site_config del Espacio que origina el correo (nunca de este env).
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="noreply@tudominio.cl"

# Keycloak — Growth OS (Authorization Code + PKCE)
# Cliente dedicado: growth-os-web (confidential, Standard flow ON, Direct access grants OFF)
# No uses admin-cli ni seminario-ipn-web en producción.
KEYCLOAK_URL=https://auth.tudominio.cl
KEYCLOAK_REALM=seminario-ipn
KEYCLOAK_CLIENT_ID=growth-os-web
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/identity/auth/keycloak/callback
# Producción (ejemplo):
# KEYCLOAK_REDIRECT_URI=https://growthos.mentorprime.cl/api/identity/auth/keycloak/callback

# Credenciales admin de Keycloak (reserva el usuario al invitar; la contraseña la crea la persona en /invite)
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=

# Almacenamiento de archivos (obligatorio en producción)
# Configúrelo en Admin → Integraciones → Almacenamiento (recomendado).
# Opcional: variables S3_* en el servidor si prefiere no usar el panel.
# SESSION_SECRET debe permanecer estable: cifra la clave secreta guardada en Integraciones.
# S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# S3_REGION=auto
# S3_BUCKET=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=

# Event Bus — runner de core_scheduled_events (OT-GROWTH-AUTOMATION-005)
# Poll in-process (ms ≥ 1000). Sin valor = solo API POST /api/events/scheduled/flush o script.
# SCHEDULED_EVENTS_POLL_MS=15000
# Secreto para despertar programados desde cron/worker (Authorization: Bearer …)
# CRON_SECRET=genera-un-secreto-largo-para-el-runner

# WhatsApp Cloud API (OT-GROWTH-MESSAGING-002 inbound / 003 outbound)
# Cada Espacio conecta su propio número/cuenta. Secretos cifrados en
# growth_whatsapp_connections — nunca en el documento del Espacio ni NEXT_PUBLIC_.
# Configuración: PUT /api/admin/integrations/whatsapp
#   (verifyToken, appSecret, accessToken — permiso settings.integrations).
# Webhook Meta: GET/POST /api/webhooks/whatsapp
# Respuesta: POST /api/growth/conversaciones/:id/reply (growth.sales.operate)
# No hay WHATSAPP_* de plataforma: un número resuelve un solo Espacio.

