MONGODB_URI=mongodb://usuario:contraseña@host:27017/?authSource=admin
MONGODB_DB=SeminarioIPN

# App URL (para URLs públicas de medios en almacenamiento local)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Almacenamiento S3-compatible (opcional — MinIO, R2, AWS S3)
# Si no se configuran, los archivos se guardan en public/media/
# S3_ENDPOINT=https://...
# S3_REGION=auto
# S3_BUCKET=aprendehoy-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://cdn.example.com
# S3_FORCE_PATH_STYLE=true

# Identity Core (IAM) — OT-CORE-IDENTITY-001
# Activar enforcement de autenticación/autorización en producción
# IDENTITY_ENFORCE=true
# SESSION_SECRET=generar-secreto-largo-aleatorio-min-32-chars
