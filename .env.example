# Base de datos
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=portal_sem

# Identidad y sesiones
IDENTITY_ENFORCE=true
SESSION_SECRET=genera-un-secreto-largo-y-aleatorio
# email | keycloak (solo Keycloak deshabilita login local)
AUTH_BACKEND=keycloak

# URL pública de la app (emails, OAuth, cookies Secure si es https://)
# Debe coincidir con el protocolo real (http vs https) del dominio en producción.
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Forzar Secure en la cookie de sesión (opcional; por defecto se infiere de APP_URL)
# SESSION_COOKIE_SECURE=false

# BackOffice — Shell Administrativo V2 (OT-UX-IMPLEMENTACION-001 Fase 1)
ADMIN_SHELL_V2=true

# Correo transaccional (Resend)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Portal SEM <noreply@tudominio.cl>"

# Keycloak — dos modos:
# A) Cliente público (sin secret): KEYCLOAK_CLIENT_SECRET vacío, ej. admin-cli
# B) Cliente confidential: copia el secret desde Credentials en Keycloak
# En ambos casos activa: Direct access grants = ON
KEYCLOAK_URL=https://auth.tudominio.cl
KEYCLOAK_REALM=seminario
KEYCLOAK_CLIENT_ID=admin-cli
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/identity/auth/keycloak/callback

# Credenciales admin de Keycloak (reserva el usuario al invitar; la contraseña la crea la persona en /invite)
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=

# Almacenamiento de archivos (obligatorio en producción)
# Configúrelo en Admin → Integraciones → Almacenamiento (recomendado).
# Opcional: variables S3_* en el servidor si prefiere no usar el panel.
# SESSION_SECRET debe permanecer estable: cifra la clave secreta guardada en Integraciones.
# S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# S3_REGION=auto
# S3_BUCKET=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=
